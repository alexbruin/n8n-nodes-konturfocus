{
  "name": "n8n-nodes-konturfocus",
  "version": "0.1.0",
  "description": "n8n community node для работы с API Контур Фокуса (developer.kontur.ru/doc/focus-v2)",
  "keywords": [
    "n8n-community-node-package",
    "kontur",
    "focus",
    "kontur-focus",
    "контрагенты"
  ],
  "license": "MIT",
  "homepage": "https://github.com/alexbruin/n8n-nodes-konturfocus",
  "author": {
    "name": "avl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexbruin/n8n-nodes-konturfocus.git"
  },
  "bugs": {
    "url": "https://github.com/alexbruin/n8n-nodes-konturfocus/issues"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "generate": "node scripts/generate-descriptions.js",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KonturFocusApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/KonturFocus/KonturFocus.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
